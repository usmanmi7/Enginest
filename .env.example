# ─── Database ──────────────────────────────────────────────────────────────
# Get your free Neon database at https://neon.tech
# After creating a project, copy the connection string here:
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/upmind?sslmode=require

# ─── Auth ───────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-key-here-change-this
NEXTAUTH_URL=http://localhost:3000

# ─── Google Gemini AI (REQUIRED) ────────────────────────────────────────────
# The AI Assistant (dashboard + public demo) uses Google Gemini.
#
# 1. Go to https://aistudio.google.com/apikey
# 2. Click "Create API key" (free tier: 15 req/min, 1500/day)
# 3. Copy the key (starts with "AIza...")
# 4. Paste it below for local dev, and add the same value to Vercel env vars
#    (Project Settings → Environment Variables) for production.
GOOGLE_AI_API_KEY=

# Optional: override the default Gemini model.
# Default is "gemini-3.8-flash" (Google deprecated gemini-2.0-flash in late 2025).
# Other options:
#   gemini-3.5-flash, gemini-3.5-flash-lite, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

# ─── ZAI AI Service (optional — only used by other AI routes as fallback) ───
ZAI_BASE_URL=https://your-ai-service-url/v1
ZAI_API_KEY=your-api-key
ZAI_CHAT_ID=
ZAI_TOKEN=
ZAI_USER_ID=

# ─── LM Studio (optional — local Gemma 3 12B) ───────────────────────────────
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=gemma-3-12b-it
